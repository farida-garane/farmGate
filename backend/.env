# Serveur
PORT=5000
NODE_ENV=development

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmgate_db
DB_USER=farmGate_user
DB_PASSWORD=farmGate_password

# URL de connexion pour Prisma (localhost car vous lancez les migrations depuis WSL)
DATABASE_URL="postgresql://farmGate_user:farmGate_password@localhost:5433/farmgate_db?schema=public"
# Authentification
JWT_SECRET=change_cette_valeur_par_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=7d

